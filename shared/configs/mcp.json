{
  "_comment": "Dev Suite MCP 配置模板 - 请根据实际需求修改",
  "_instructions": "复制此文件到 ~/.claude.json 或项目 .mcp.json",
  
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "@playwright/mcp@latest"],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "@upstash/context7-mcp@latest"],
      "env": {}
    },
    "github": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-github@latest"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c", "npx", "-y",
        "@modelcontextprotocol/server-filesystem",
        "${WORKSPACE_PATH}",
        "${HOME_PATH}"
      ],
      "env": {}
    },
    "memory": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "env": {}
    },
    "sqlite": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c", "npx", "-y",
        "mcp-server-sqlite-npx",
        "${DB_PATH}"
      ],
      "env": {}
    },
    "ssh": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "python", "-m", "mcpssh.main"],
      "env": {}
    },
    "python-sqlite": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "python", "-m", "mcp_server_sqlite_cn.server"],
      "env": {}
    }
  },

  "_envVariables": {
    "GITHUB_TOKEN": "请替换为你的 GitHub Personal Access Token",
    "WORKSPACE_PATH": "请替换为你的工作区路径",
    "HOME_PATH": "请替换为你的 home 路径",
    "DB_PATH": "请替换为你的 SQLite 数据库路径"
  },

  "_recommendedServers": {
    "必选": [
      "playwright",
      "context7",
      "github",
      "filesystem",
      "memory"
    ],
    "可选": [
      "sqlite",
      "ssh",
      "python-sqlite"
    ]
  },

  "_installNotes": {
    "Windows": "使用 cmd /c npx 格式",
    "Linux/Mac": "使用 npx 直接执行"
  }
}
